# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...

# Произвольная длинная строка (A-Z, a-z, 0-9, _ и -). Telegram будет присылать её в заголовке webhook.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Upstash Redis. На Vercel проставляются автоматически при подключении Upstash из Marketplace.
# Подойдёт любая из пар: UPSTASH_REDIS_REST_URL/UPSTASH_REDIS_REST_TOKEN или KV_REST_API_URL/KV_REST_API_TOKEN.
# Если не указать — локально бот работает с хранилищем в памяти (данные пропадут после перезапуска).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Только для npm run set-webhook: адрес деплоя на Vercel
WEBHOOK_URL=https://your-project.vercel.app/api/bot
